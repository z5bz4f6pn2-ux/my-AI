{
  "name": "my-ai",
  "main": "worker.js",
  "compatibility_date": "2026-08-11",

  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },

  "ai": {
    "binding": "AI"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-ai-db",
      "database_id": "YOUR_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
