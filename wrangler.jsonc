{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-ai",
  "main": "worker.js",
  "compatibility_date": "2026-09-05",

  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },

  "ai": {
    "binding": "AI"
  },

  "vars": {
    "ADMIN_EMAIL": "thomasbateman6@gmail.com",
    "DEVICE_API_URL": "https://my-ai-device.z5bz4f6pn2.workers.dev"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-ai-memory",
      "database_id": "5a13b867-beb0-458a-aed4-07fa163443c6",
      "migrations_dir": "migrations"
    }
  ]
}
